rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isVendor() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'vendor'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isCustomer() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'customer'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isInquiryParticipant(data) {
      return isSignedIn()
        && (data.customerId == request.auth.uid || data.vendorId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isEmailVerified();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isOwner(customerId) || isAdmin();
      allow create: if isOwner(customerId) && isEmailVerified();
      allow update: if isOwner(customerId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /pendingRegistrations/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && !isEmailVerified()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^\\+9779[678][0-9]{8}$')
        && request.resource.data.createdAt == request.time
        && (
          (
            request.resource.data.role == 'customer'
            && request.resource.data.keys().hasOnly([
              'name',
              'email',
              'phone',
              'role',
              'createdAt'
            ])
          )
          || (
            request.resource.data.role == 'vendor'
            && request.resource.data.businessName is string
            && request.resource.data.businessName.size() > 0
            && request.resource.data.category is string
            && request.resource.data.location is string
            && request.resource.data.location in [
              'Kathmandu',
              'Lalitpur',
              'Bhaktapur'
            ]
            && request.resource.data.keys().hasOnly([
              'name',
              'email',
              'phone',
              'role',
              'businessName',
              'category',
              'location',
              'createdAt'
            ])
          )
        );
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    match /public_profiles/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName',
          'role',
          'profileImageUrl',
          'updatedAt'
        ]);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /vendors/{vendorId} {
      allow read: if isSignedIn();
      allow create: if isOwner(vendorId) && isEmailVerified();
      allow update: if isOwner(vendorId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isVendor() || isAdmin();
    }

    match /service_images/{imageId} {
      allow read: if isSignedIn();
      allow create: if isVendor()
        && request.resource.data.vendorId == request.auth.uid
        && request.resource.data.bytes is bytes
        && request.resource.data.bytes.size() <= 768000
        && request.resource.data.size() <= 5;
      allow update: if false;
      allow delete: if isAdmin()
        || (isVendor() && resource.data.vendorId == request.auth.uid);
    }

    match /profile_images/{imageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role is string
        && request.resource.data.bytes is bytes
        && request.resource.data.bytes.size() <= 768000
        && request.resource.data.size() <= 5;
      allow update: if false;
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn();
      allow create: if isCustomer() || isAdmin();
      allow update: if isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    match /inquiries/{inquiryId} {
      allow read: if isInquiryParticipant(resource.data) || isAdmin();

      allow create: if isCustomer()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.vendorId is string
        && request.resource.data.vendorId.size() > 0
        && request.resource.data.status == 'pending';

      allow update: if isAdmin()
        || (
          isInquiryParticipant(resource.data)
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.vendorId == resource.data.vendorId
          && request.resource.data.status == 'pending'
          && (
            (
              request.auth.uid == resource.data.customerId
              && request.resource.data.unreadForCustomer == false
              && request.resource.data.unreadForVendor == true
            )
            || (
              request.auth.uid == resource.data.vendorId
              && request.resource.data.unreadForCustomer == true
              && request.resource.data.unreadForVendor == false
            )
          )
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'lastMessage',
              'lastMessageAt',
              'updatedAt',
              'status',
              'closedAt',
              'unreadForCustomer',
              'unreadForVendor'
            ])
        )
        || (
          isOwner(resource.data.customerId)
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.vendorId == resource.data.vendorId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['customerName', 'customerEmail', 'updatedAt'])
        )
        || (
          isOwner(resource.data.customerId)
          && request.resource.data.unreadForCustomer == false
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['unreadForCustomer'])
        )
        || (
          isOwner(resource.data.vendorId)
          && request.resource.data.unreadForVendor == false
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['unreadForVendor'])
        )
        ;

      allow delete: if isAdmin();

      match /messages/{messageId} {
        function parentAfter() {
          return getAfter(/databases/$(database)/documents/inquiries/$(inquiryId)).data;
        }

        allow read: if isInquiryParticipant(
          get(/databases/$(database)/documents/inquiries/$(inquiryId)).data
        ) || isAdmin();

        allow create: if isInquiryParticipant(parentAfter())
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt is timestamp;

        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create, update: if isCustomer() || isAdmin();
      allow delete: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blog_images/{imageId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.bytes is bytes
        && request.resource.data.bytes.size() <= 768000
        && request.resource.data.size() <= 4;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /guests/{guestId} {
      allow read, delete: if isSignedIn()
        && resource.data.customerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == request.auth.uid;
    }

    match /checklistTasks/{taskId} {
      allow read, delete: if isSignedIn()
        && resource.data.customerId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }
  }
}
